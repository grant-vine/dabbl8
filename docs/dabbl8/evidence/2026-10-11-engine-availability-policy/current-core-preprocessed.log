static void params_by_count(int16_t *out, const int16_t *in, uint32_t np, const int16_t *def)
{
    uint32_t i, nc = np - 8u;
    for (i = 0; i < P_E0; i++)
        out[i] = i < nc ? in[i] : def[i];
    for (i = 0; i < 8u; i++)
        out[P_E0 + i] = in[nc + i];
}
static int drum_from_phys(uint32_t engine, int16_t *e)
{
    if (engine != 9u || e[0] != 4)
        return 0;
    e[0] = (int16_t)((e[7] < 0 ? 0 : e[7] > 127 ? 127 : e[7]) >> 5);
    e[6] = (int16_t)(e[6] >= 64);
    e[7] = 0;
    return 1;
}
static int drum_from_perc(uint32_t engine, int16_t *e)
{
    static const int16_t KIT[8] = {0, 64, 70, 64, 64, 100, 0, 0};
    uint32_t i;
    if (engine != 4u || e[0] != (int16_t)4u)
        return 0;
    for (i = 0; i < 8u; i++)
        e[i] = KIT[i];
    return 1;
}
