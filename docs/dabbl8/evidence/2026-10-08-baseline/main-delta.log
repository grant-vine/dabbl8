+    else if (s == 2u)
         lcd_cmd(0x29);                             /* DISPON */
-    fm1_irq_off();                                 /* (port A: the key scan's rows too) */
-    fm1_lcd_backlight(s == 2u);
-    fm1_irq_on();
-    if (s == 0u) {
+    else {
         lcd_cmd(0x28);                             /* DISPOFF */
         lcd_cmd(0x10);                             /* SLPIN */
     }
